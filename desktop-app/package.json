{
  "name": "alcor-desktop",
  "version": "0.2.1",
  "private": true,
  "overrides": {
    "csstype": "3.1.3"
  },
  "description": "星引 Alcor 智能体总管",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:release": "node --import tsx --test --test-concurrency=2 tests/projects.test.ts tests/local-projects.test.ts tests/chat-delivery.test.ts tests/dsh.test.ts tests/dsh-desktop.test.ts tests/mobile.test.ts",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "prettier": "3.6.2",
    "rcedit": "4.0.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
