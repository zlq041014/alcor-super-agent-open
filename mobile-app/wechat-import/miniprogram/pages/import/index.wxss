page { background: #f7f8fc; color: #25283b; }
.page { padding: 56rpx 36rpx; }
.title { font-size: 44rpx; font-weight: 600; }
.hint, .file, .error { margin: 28rpx 0; line-height: 1.65; overflow-wrap: anywhere; }
.hint { color: #5f6478; }
.file { background: white; border-radius: 18rpx; padding: 20rpx; }
.error { color: #a43222; }
